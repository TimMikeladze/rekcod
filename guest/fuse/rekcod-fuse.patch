 }
 
 /* Work function for request completion */
+/*
+ * rekcod: the host server hands out near-zero cache timeouts and never caches
+ * negative lookups, so almost every stat/open crosses into macOS. With the
+ * "rekcod" mount option, replies are rewritten to cache for a day; the host
+ * watches the shared directories and invalidates changed paths through
+ * /sys/module/fuse/parameters/rekcod_notify (fs/fuse/rekcod.c).
+ */
+#define REKCOD_TTL_SEC (24 * 60 * 60)
+
+/* Requests answered by the host, per opcode; read /sys/module/virtiofs/parameters/rekcod_stats. */
+#define REKCOD_OPS 64
+static atomic64_t rekcod_ops[REKCOD_OPS];
+
+static int rekcod_stats_get(char *buf, const struct kernel_param *kp)
+{
+	int i, n = 0;
+
+	for (i = 0; i < REKCOD_OPS; i++) {
+		s64 v = atomic64_read(&rekcod_ops[i]);
+
+		if (v)
+			n += sysfs_emit_at(buf, n, "%d %lld\n", i, v);
+	}
+	return n;
+}
+
+static const struct kernel_param_ops rekcod_stats_ops = { .get = rekcod_stats_get };
+module_param_cb(rekcod_stats, &rekcod_stats_ops, NULL, 0444);
+
+static void rekcod_entry_ttl(struct fuse_entry_out *e)
+{
+	e->entry_valid = REKCOD_TTL_SEC;
+	e->entry_valid_nsec = 0;
+	e->attr_valid = REKCOD_TTL_SEC;
+	e->attr_valid_nsec = 0;
+}
+
+/* READDIRPLUS replies carry an entry_out per name; the reply sits in pages. */
+static void rekcod_readdirplus_ttl(struct fuse_args_pages *ap, unsigned int len)
+{
+	unsigned int i;
+
+	for (i = 0; i < ap->num_pages && len; i++) {
+		unsigned int left = min(len, ap->descs[i].length);
+		char *base = kmap_local_page(ap->pages[i]);
+		char *p = base + ap->descs[i].offset;
+
+		len -= left;
+		while (left >= FUSE_NAME_OFFSET_DIRENTPLUS) {
+			struct fuse_direntplus *d = (struct fuse_direntplus *)p;
+			size_t reclen = FUSE_DIRENTPLUS_SIZE(d);
+
+			if (!d->dirent.namelen || reclen > left)
+				break;
+			rekcod_entry_ttl(&d->entry_out);
+			p += reclen;
+			left -= reclen;
+		}
+		kunmap_local(base);
+	}
+}
+
+static void *rekcod_out(struct fuse_args *args, unsigned int i, size_t size)
+{
+	if (args->out_numargs <= i || args->out_args[i].size < size)
+		return NULL;
+	return args->out_args[i].value;
+}
+
+/*
+ * A reply racing with a host-driven invalidation may describe the old state
+ * (the request left before the change was announced). Don't pin such replies
+ * for a day: keep the server's short timeouts while invalidations are recent.
+ */
+#define REKCOD_QUIET_MS 50
+
+static bool rekcod_quiet(void)
+{
+	return time_after64(get_jiffies_64(),
+			    atomic64_read(&rekcod_last_inval) + msecs_to_jiffies(REKCOD_QUIET_MS));
+}
+
+static void rekcod_rewrite_reply(struct fuse_req *req)
+{
+	struct fuse_args *args = req->args;
+	bool quiet = rekcod_quiet();
+	struct fuse_entry_out *entry;
+	struct fuse_attr_out *attr;
+	struct fuse_statx_out *statx;
+	struct fuse_open_out *open;
+
+	switch (req->in.h.opcode) {
+	case FUSE_LOOKUP:
+		entry = rekcod_out(args, 0, sizeof(*entry));
+		if (!entry)
+			return;
+		if (!quiet)
+			return;
+		if (req->out.h.error == -ENOENT) {
+			/* nodeid 0 = negative entry with a valid timeout */
+			memset(entry, 0, sizeof(*entry));
+			entry->entry_valid = REKCOD_TTL_SEC;
+			req->out.h.error = 0;
+		} else if (!req->out.h.error) {
+			rekcod_entry_ttl(entry);
+		}
+		return;
+	case FUSE_MKNOD:
+	case FUSE_MKDIR:
+	case FUSE_SYMLINK:
+	case FUSE_LINK:
+	case FUSE_TMPFILE:
+	case FUSE_CREATE:
+		if (req->out.h.error)
+			return;
+		entry = rekcod_out(args, 0, sizeof(*entry));
+		if (entry && quiet)
+			rekcod_entry_ttl(entry);
+		if (req->in.h.opcode == FUSE_CREATE) {
+			open = rekcod_out(args, 1, sizeof(*open));
+			if (open)
+				open->open_flags |= FOPEN_KEEP_CACHE;
+		}
+		return;
+	case FUSE_GETATTR:
+	case FUSE_SETATTR:
+		attr = rekcod_out(args, 0, sizeof(*attr));
+		if (attr && !req->out.h.error && quiet) {
+			attr->attr_valid = REKCOD_TTL_SEC;
+			attr->attr_valid_nsec = 0;
+		}
+		return;
+	case FUSE_STATX:
+		statx = rekcod_out(args, 0, sizeof(*statx));
+		if (statx && !req->out.h.error && quiet) {
+			statx->attr_valid = REKCOD_TTL_SEC;
+			statx->attr_valid_nsec = 0;
+		}
+		return;
+	case FUSE_READDIRPLUS:
+		if (!req->out.h.error && args->out_pages && args->out_numargs && quiet)
+			rekcod_readdirplus_ttl(container_of(args, struct fuse_args_pages, args),
+					       args->out_args[args->out_numargs - 1].size);
+		return;
+	case FUSE_OPEN:
+	case FUSE_OPENDIR:
+		open = rekcod_out(args, 0, sizeof(*open));
+		if (!open || req->out.h.error)
+			return;
+		pr_info_once("virtio-fs: rekcod: server open_flags 0x%x\n", open->open_flags);
+		/* Page cache instead of per-read host round trips; rekcod_notify drops stale pages. */
+		open->open_flags &= ~(FOPEN_DIRECT_IO | FOPEN_NOFLUSH);
+		open->open_flags |= FOPEN_KEEP_CACHE |
+			(req->in.h.opcode == FUSE_OPENDIR ? FOPEN_CACHE_DIR : 0);
+		return;
+	}
+}
