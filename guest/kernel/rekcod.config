# rekcod guest kernel fragment, merged over Alpine's config-virt (docs/custom-kernel.md).
# Built in: everything boot.sh and dockerd load on every boot, so no initramfs is
# needed and no modprobe runs on the boot path. Off: hardware VZ never presents.

# Boot: root disk, console, entropy, no initramfs
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_EXT4_FS=y
CONFIG_JBD2=y
CONFIG_CRC16=y
CONFIG_CRYPTO_CRC32C=y
CONFIG_LIBCRC32C=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Network, vsock, file sharing
CONFIG_VIRTIO_NET=y
CONFIG_NET_FAILOVER=y
CONFIG_FAILOVER=y
CONFIG_PACKET=y
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS_COMMON=y
CONFIG_FUSE_FS=y
CONFIG_VIRTIO_FS=y
CONFIG_BINFMT_MISC=y
CONFIG_BLK_DEV_LOOP=y

# Docker: overlay, bridge/veth, netfilter (iptables-nft), xfrm for overlay networks
CONFIG_OVERLAY_FS=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_STP=y
CONFIG_LLC=y
CONFIG_VETH=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_NETLINK=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CT_NETLINK=y
CONFIG_NF_DEFRAG_IPV4=y
CONFIG_NF_DEFRAG_IPV6=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_CT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_COMPAT=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_NAT=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_REDIRECT=y
CONFIG_NETFILTER_XT_SET=y
CONFIG_IP_SET=y
CONFIG_XFRM_ALGO=y
CONFIG_XFRM_USER=y

# Hardware VZ doesn't present
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_BACKLIGHT_CLASS_DEVICE is not set
# CONFIG_SOUND is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_WLAN is not set
# CONFIG_WIRELESS is not set
# CONFIG_CFG80211 is not set
# CONFIG_BT is not set
# CONFIG_NFC is not set
# CONFIG_INPUT_JOYSTICK is not set
# CONFIG_INPUT_TOUCHSCREEN is not set
# CONFIG_INPUT_TABLET is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_ATA is not set
# CONFIG_MD is not set
# CONFIG_INFINIBAND is not set
# CONFIG_ISDN is not set
# CONFIG_PCCARD is not set
# CONFIG_MTD is not set
# CONFIG_IIO is not set
# CONFIG_STAGING is not set
# CONFIG_FIREWIRE_SUPPORT is not set
# CONFIG_THUNDERBOLT is not set
# CONFIG_ETHERNET is not set
# CONFIG_CAN is not set
# CONFIG_HAMRADIO is not set
# CONFIG_DEBUG_INFO_BTF is not set

# Alpine's config names its builder's signing key; the default path makes the
# build generate a throwaway one per image.
CONFIG_MODULE_SIG_KEY="certs/signing_key.pem"
CONFIG_SYSTEM_TRUSTED_KEYS=""
