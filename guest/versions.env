# Pinned guest inputs. guest/build.sh sources this (POSIX sh), and CI's kernel cache key
# hashes it, so a bump here recompiles the kernel.
#
# An env var of the same name overrides a value. Override the matching *_SHA256 with it,
# or the download check fails.
#
# Alpine keeps only the newest linux-virt in a release branch. Once it moves past
# LINUX_VIRT_VERSION, `apk add linux-virt=...` fails and the build stops until this file
# is bumped (docs/guest-build.md, "Bumping pinned versions").

# Minirootfs for the chroots: dl-cdn.alpinelinux.org/alpine/v3.22/releases/aarch64/
: "${ALPINE_RELEASE:=3.22.6}"
: "${MINIROOTFS_SHA256:=821565fa8f3953eefd12497b166b4b50add2f7c57fb312e75862f5867e06fefe}"

# download.docker.com/linux/static/stable/aarch64/docker-$DOCKER_VERSION.tgz
: "${DOCKER_VERSION:=29.9.0}"
: "${DOCKER_SHA256:=811f6eee271678fc98dbe5c4d896c00fc5fe2daa4f7a37069c17abc036eab85b}"

# Alpine's linux-virt package (its config, and the kernel version we build), and the
# kernel.org tarball for that version (matches cdn.kernel.org's sha256sums.asc).
: "${LINUX_VIRT_VERSION:=6.12.113-r0}"
: "${LINUX_SHA256:=e09b6727e5c521253f0d41694900b9c38fb7604db7d35238a8197aa9f7de2428}"
