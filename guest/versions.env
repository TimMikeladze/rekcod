# Pinned guest inputs. guest/build.sh sources this (POSIX sh), and CI's kernel cache key
# hashes it, so a bump here recompiles the kernel.
#
# An env var of the same name overrides a value. Override the matching *_SHA256 with it,
# or the download check fails.
#
# scripts/bump-versions.py moves these to the newest releases (CI runs it weekly and opens
# a PR). The guest runs the newest stable kernel series. A new series also needs the fuse
# patch rebased (guest/fuse/) and guest/kernel/base.config replaced; the script says when.

# Minirootfs for the chroots: dl-cdn.alpinelinux.org/alpine/v3.24/releases/aarch64/
: "${ALPINE_RELEASE:=3.24.4}"
: "${MINIROOTFS_SHA256:=4b14c18f7e90a063b61462ea1462a5732c154bf6adad594974fe6487cd98a8de}"

# download.docker.com/linux/static/stable/aarch64/docker-$DOCKER_VERSION.tgz
: "${DOCKER_VERSION:=29.9.3}"
: "${DOCKER_SHA256:=1b27fd739378ef938401e81ce5afb73b7ad7432d4f598814a9ff5f826bb464d2}"

# The guest kernel: cdn.kernel.org's linux-$LINUX_VERSION.tar.xz (sha256 from its
# sha256sums.asc), built with guest/kernel/base.config + guest/kernel/rekcod.config.
: "${LINUX_VERSION:=7.3.3}"
: "${LINUX_SHA256:=79c66dde66cd96877fcde8f7d36aec946b1f423d2b97b5a7b1751b75c764f3d1}"

# KERNEL=alpine only (Alpine's stock kernel, for bisecting): the linux-virt package of the
# same kernel version, from Alpine edge. Edge keeps only its newest linux-virt, so this
# stops resolving once edge moves past it; the default custom kernel doesn't use it.
: "${LINUX_VIRT_VERSION:=7.3.3-r0}"
: "${ALPINE_KERNEL_REPO:=https://dl-cdn.alpinelinux.org/alpine/edge/main}"
