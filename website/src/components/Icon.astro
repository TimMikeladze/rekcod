---
import {
  siApple, siBun, siCloudflare, siDiscord, siDocker, siGithub, siGithubactions, siHomebrew,
  siLinux, siModelcontextprotocol, siNodedotjs, siPython, siRust, siTailscale, siUv, siX,
} from 'simple-icons';
import type { BrandName, GlyphName } from '../lib/landing';

// Glyphs: one stroked set on a 24 grid. Brand marks: simple-icons paths (CC0), solid.
// LinkedIn is no longer in simple-icons, so its mark is drawn here.
interface Props { name: GlyphName | BrandName | 'mark'; size?: number; color?: boolean; class?: string }
const { name, size = 16, color = false, class: className } = Astro.props;

const glyphs: Record<GlyphName, string> = {
  copy: '<rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1"/>',
  check: '<path d="m5 12 5 5L20 7"/>',
  book: '<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20V3H6.5A2.5 2.5 0 0 0 4 5.5z"/><path d="M4 19.5A2.5 2.5 0 0 0 6.5 22H20v-5"/>',
  arrow: '<path d="M5 12h14m-6-6 6 6-6 6"/>',
  sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>',
  moon: '<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>',
  monitor: '<rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8m-4-4v4"/>',
  terminal: '<path d="m4 17 6-6-6-6m8 14h8"/>',
  file: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/>',
  bot: '<rect x="4" y="8" width="16" height="12" rx="2"/><path d="M12 8V4m-3 9v1m6-1v1"/>',
};

const linkedin = 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zM7.119 20.452H3.555V9h3.564zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0z';

const brands: Record<BrandName, { path: string; hex: string }> = {
  github: siGithub, x: siX, linkedin: { path: linkedin, hex: '0A66C2' }, discord: siDiscord,
  apple: siApple, docker: siDocker, linux: siLinux, homebrew: siHomebrew, bun: siBun,
  nodedotjs: siNodedotjs, python: siPython, uv: siUv, rust: siRust, tailscale: siTailscale,
  cloudflare: siCloudflare, githubactions: siGithubactions, modelcontextprotocol: siModelcontextprotocol,
};

const glyph = (glyphs as Record<string, string>)[name];
const brand = (brands as Record<string, { path: string; hex: string }>)[name];
// Near-black brand colours vanish on the dark page; those marks use currentColor.
const luminance = (hex: string) => [0, 2, 4].reduce((sum, i, k) => sum + [0.2126, 0.7152, 0.0722][k] * parseInt(hex.slice(i, i + 2), 16) / 255, 0);
const fill = color && brand && luminance(brand.hex) > 0.25 ? `#${brand.hex}` : 'currentColor';
---
{name === 'mark' ? (
  <svg class={className} width={size} height={size} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path transform="rotate(180 12 12)" d={siDocker.path} /></svg>
) : glyph ? (
  <svg class={className} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={glyph} />
) : (
  <svg class={className} width={size} height={size} viewBox="0 0 24 24" fill={fill} aria-hidden="true"><path d={brand.path} /></svg>
)}
