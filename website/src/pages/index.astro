---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import HeroDiagram from '../components/HeroDiagram.astro';
import { load } from '../lib/landing';
import { block, code, commandIndex, consoleHtml, inline } from '../lib/render';

const { landing: l } = load();
const lede = await inline(l.lede);
const startText = await inline(l.start.text);
const startCode = await code(l.start.example.block);
const whyText = await inline(l.why.text);
const howText = await inline(l.how.text);
const crossings = await Promise.all(l.how.crossings.map(async (c) => ({ ...c, text: await inline(c.text) })));
const filesText = await inline(l.files.text);
const decisions = await Promise.all(l.decisions.items.map(async (d) => ({ ...d, text: await inline(d.text) })));
const commandsText = await inline(l.commands.text);
const capabilities = await Promise.all(l.capabilities.map(async ({ example, ...section }) => ({
  ...section,
  example,
  text: await inline(section.text),
  html: example.kind === 'terminal'
    ? consoleHtml(example.block.value, commandIndex(example.block.value, example.command))
    : await code(example.block),
})));
const switchText = await inline(l.switching.text);
const switchCode = await code(l.switching.example.block);
const measuredText = await block(l.measured.text);
const measuredMethod = await block(l.measured.method);
const benchmark = consoleHtml(l.measured.terminal.block.value);
const limitsText = await block(l.limitations.text);
const limitsList = await block(l.limitations.list);
---
<Base title={l.title} description={l.description} path="/" markdown="/index.md">
  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-grid shell">
        <div class="hero-copy">
          <h1 id="hero-title">{l.h1}</h1>
          <p class="lede" set:html={lede} />
          <p class="hero-meta mono">{l.meta}</p>
        </div>
        <div class="audience" id={l.start.id}>
          <input type="radio" name="audience" id="for-humans" checked />
          <input type="radio" name="audience" id="for-agents" />
          <div class="audience-tabs">
            <label for="for-humans">{l.start.title}</label>
            <label for="for-agents">Agent docs</label>
          </div>
          <div class="audience-panel" data-panel="humans">
            <div class="frame">
              <div class="frame-bar">
                <Icon name="terminal" size={14} />
                <span class="mono">Terminal</span>
                <button type="button" class="bar-copy" data-copy={l.start.example.block.value} aria-label="Copy install and run commands"><Icon name="copy" size={14} class="i-copy" /><Icon name="check" size={14} class="i-check" /></button>
              </div>
              <div class="frame-body" set:html={startCode} />
            </div>
            <p class="start-note" set:html={startText} />
            <a class="section-link" href={l.start.href}>Installation details</a>
          </div>
          <div class="audience-panel" data-panel="agents">
            <div class="pill">
              <span class="ps" aria-hidden="true">$</span><code>{l.agentCommand}</code>
              <button type="button" class="pill-copy" data-copy={l.agentCommand} aria-label="Copy llms.txt command"><Icon name="copy" class="i-copy" /><Icon name="check" class="i-check" /></button>
            </div>
            <p class="agent-links">
              <a href="/llms.txt">llms.txt</a>
              <a href="/AGENTS.md">AGENTS.md</a>
              <a href="/index.md" data-copy-url="/index.md">Copy page as Markdown</a>
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id={l.why.id} aria-labelledby="why-title">
      <div class="shell statement">
        <h2 id="why-title">{l.why.title}</h2>
        <p class="explain" set:html={whyText} />
      </div>
    </section>

    <section class="section section--band" id={l.how.id} aria-labelledby="how-title">
      <div class="shell">
        <h2 id="how-title">{l.how.title}</h2>
        <p class="explain" set:html={howText} />
        <div class="how-grid">
          <figure class="how-figure" id="architecture">
            <HeroDiagram d={l.diagram} />
            <figcaption>Hover, tab, or tap a label for details.</figcaption>
          </figure>
          <dl class="crossings">
            {crossings.map((c) => (
              <div>
                <dt><span>{c.title}</span>{c.measure && <span class="measure mono">{c.measure}</span>}</dt>
                <dd><p set:html={c.text} /><a class="section-link" href={c.href}>{c.link}</a></dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </section>

    <section class="section" id={l.files.id} aria-labelledby="files-title">
      <div class="shell">
        <h2 id="files-title">{l.files.title}</h2>
        <p class="explain" set:html={filesText} />
        <ol class="flow">
          {l.files.steps.map((s) => (
            <li>
              <span class="who mono">{s.from === s.to ? s.from : `${s.from} → ${s.to}`}</span>
              <span class="what">{s.text}</span>
            </li>
          ))}
        </ol>
        <a class="section-link" href={l.files.href}>File sharing and change notifications</a>
      </div>
    </section>

    <section class="section section--band" id={l.decisions.id} aria-labelledby="design-title">
      <div class="shell">
        <h2 id="design-title">{l.decisions.title}</h2>
        <div class="decisions">
          {decisions.map((d) => (
            <div>
              <h3>{d.title}</h3>
              <p class="explain" set:html={d.text} />
              <a class="section-link" href={d.href}>Details</a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id={l.commands.id} aria-labelledby="commands-title">
      <div class="shell">
        <h2 id="commands-title">{l.commands.title}</h2>
        <p class="explain" set:html={commandsText} />
        {capabilities.map(({ id, title, text, example, guide, html }) => (
          <section class="capability" id={id} aria-labelledby={`${id}-title`}>
            <div class="capability-copy">
              <h3 id={`${id}-title`}>{title}</h3>
              <p class="explain" set:html={text} />
              <a class="section-link" href={`/docs/#${id}`}>{guide}</a>
            </div>
            <div class="example frame">
              <div class="frame-bar">
                <Icon name={example.block.lang === 'yaml' ? 'file' : 'terminal'} size={14} />
                <span class="mono">{example.kind === 'terminal' ? 'Terminal output' : example.label}</span>
                {example.kind === 'snippet' && (
                  <button type="button" class="bar-copy" data-copy={example.block.value} aria-label={`Copy example: ${title}`}><Icon name="copy" size={14} class="i-copy" /><Icon name="check" size={14} class="i-check" /></button>
                )}
              </div>
              <div class="frame-body" set:html={html} />
            </div>
          </section>
        ))}
      </div>
    </section>

    <section class="section section--band" id={l.switching.id} aria-labelledby="switching-title">
      <div class="shell capability capability--flat">
        <div class="capability-copy">
          <h2 id="switching-title">{l.switching.title}</h2>
          <p class="explain" set:html={switchText} />
          <a class="section-link" href={`/docs/#${l.switching.id}`}>{l.switching.guide}</a>
        </div>
        <div class="example frame">
          <div class="frame-bar">
            <Icon name="terminal" size={14} />
            <span class="mono">{l.switching.example.label}</span>
            <button type="button" class="bar-copy" data-copy={l.switching.example.block.value} aria-label="Copy import commands"><Icon name="copy" size={14} class="i-copy" /><Icon name="check" size={14} class="i-check" /></button>
          </div>
          <div class="frame-body" set:html={switchCode} />
        </div>
      </div>
    </section>

    <section class="section" id={l.measured.id} aria-labelledby="benchmarks-title">
      <div class="shell">
        <h2 id="benchmarks-title">{l.measured.title}</h2>
        <div class="explain" set:html={measuredText} />
        <div class="example example--wide frame">
          <div class="frame-bar"><Icon name="terminal" size={14} /><span class="mono">Terminal output</span></div>
          <div class="frame-body" set:html={benchmark} />
        </div>
        <div class="explain" set:html={measuredMethod} />
        <a class="section-link" href={l.measured.href}>Benchmark commands and output</a>
      </div>
    </section>

    <section class="section section--band" id={l.limitations.id} aria-labelledby="limitations-title">
      <div class="shell">
        <h2 id="limitations-title">{l.limitations.title}</h2>
        <div class="explain" set:html={limitsText} />
        <div class="explain limits" set:html={limitsList} />
      </div>
    </section>

    <section class="section" aria-labelledby="guides-title">
      <div class="shell">
        <h2 id="guides-title">More in the docs</h2>
        <ul class="guide-links">
          {l.guides.map(({ label, href }) => <li><a class="section-link" href={href}>{label}</a></li>)}
        </ul>
      </div>
    </section>
  </main>
</Base>
